APP_NAME=PharmacyCat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# SMTP Mail Configuration
# --------------------------------------------------------------------------
# MAIL_MAILER: The mail transport driver (e.g., 'smtp' to send real emails, or 'log' for local testing)
# MAIL_SCHEME: Encryption protocol ('smtp' uses STARTTLS on port 587; 'smtps' uses SSL on port 465)
# MAIL_HOST: SMTP server hostname (e.g., smtp.gmail.com or smtp-relay.brevo.com)
# MAIL_PORT: SMTP port (usually 587 for TLS or 465 for SSL)
# MAIL_USERNAME: Account / email address authenticated with the SMTP provider
# MAIL_PASSWORD: App password or API key generated by the mail provider
# MAIL_FROM_ADDRESS: Default "From" sender email address shown to recipients
# MAIL_FROM_NAME: Display name that appears in recipient inboxes (defaults to APP_NAME)
# MAIL_ADMIN_ADDRESS: Pharmacy manager inbox that receives notifications (new orders, enquiries)
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM_ADDRESS=pharmacycat@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=pharmacycat@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
